<header>
  <!-- One-time loading screen (skipped after the first page in a visit, and with reduced motion) -->
  <script>
    try {
      if (sessionStorage.getItem('krSeen') || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('kr-seen');
      }
    } catch (e) {
      document.documentElement.classList.add('kr-seen');
    }
  </script>
  <div id="kr-loader" aria-hidden="true">
    <img src="{{ '/assets/img/logo/resiloris-emblem-dark.svg' | relative_url }}" alt="" width="120" height="120">
    <span>
      {{- site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name -}}
    </span>
  </div>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-xl {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="kr-topbar">
      <div class="container-fluid site-wide-container">
        <span class="kr-topbar-note">Integrated plant systems for climate resilience</span>
        <span class="kr-topbar-links">
          {% if site.data.socials.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener"
              >Google Scholar</a
            >
          {% endif %}
          {% if site.data.socials.cv_pdf %}
            <a href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank" rel="noopener">Download CV</a>
          {% endif %}
        </span>
      </div>
    </div>
    <div class="container-fluid site-wide-container">
      <a class="navbar-brand kr-brand" href="{{ site.baseurl }}/">
        <img src="{{ '/assets/img/logo/resiloris-emblem-light.svg' | relative_url }}" alt="RESILORIS logo" class="navbar-logo only-light"
        ><img src="{{ '/assets/img/logo/resiloris-emblem-dark.svg' | relative_url }}" alt="" aria-hidden="true" class="navbar-logo only-dark">
        <span class="kr-brand-text">
          <span class="kr-brand-name">
            {%- if site.title == 'blank' -%}
              {{- site.first_name }}
              {{ site.last_name -}}
            {%- else -%}
              {{- site.title -}}
            {%- endif -%}
          </span>
          <span class="kr-brand-tag kr-rotator" data-words="{{ site.data.home.hero.rotating | join: '|' }}">
            {{- site.data.home.hero.rotating | first -}}
          </span>
        </span>
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link"><i class="fa-solid fa-magnifying-glass"></i> <kbd class="search-kbd">ctrl k</kbd></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
